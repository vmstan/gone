{
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "name": "gone",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "vmst.io"
    },
    {
      "pattern": "*.vmst.io/*",
      "zone_name": "vmst.io"
    }
  ],
  "rules": [
    {
      "fallthrough": true,
      "globs": ["**/*.svg"],
      "type": "Text"
    }
  ]
}
