{
  "name": "gone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "description": "Tiny Cloudflare Worker that responds to every request with HTTP 410 Gone.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "pnpm run test:unit && pnpm run test:runtime",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=page.js --test-coverage-include=router.js --test-coverage-include=worker.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/worker.test.mjs test/worker-entry.test.mjs test/page-browser.test.mjs",
    "test:runtime": "vitest run --config vitest.config.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
